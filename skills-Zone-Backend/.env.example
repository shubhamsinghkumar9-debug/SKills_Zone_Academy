# ─── MongoDB ───────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/sheryians
# or Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/sheryians

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── Flask ─────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=another-random-secret-for-flask-sessions

# ─── Email (Gmail SMTP) ────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password      # Use App Password, not real password
MAIL_DEFAULT_SENDER=Sheryians <your-email@gmail.com>
ADMIN_EMAIL=admin@sheryians.com

# ─── Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
